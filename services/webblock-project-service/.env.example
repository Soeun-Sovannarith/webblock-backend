# Environment of the Project service. Copy to `.env` (git-ignored), fill the empty values, never commit it.
# Spring does not read this file itself: load it into the shell first (`set -a; . ./.env; set +a`) or point the
# IDE run configuration at it. Every name below is read by src/main/resources/application*.yml; the value shown is
# the default the service uses when the variable is unset. Empty means "no default: set it".

# Profile: exactly one of prototype (stand-ins allowed, migrates at start) or production (JWT only, no stand-in,
# no migration). ProfileGuard refuses anything else.
SPRING_PROFILES_ACTIVE=prototype

# Project database (PostgreSQL 18). Roles and the database: .claude/docs/runbooks/database.md.
# The URL must not carry logServerErrorDetail, socketTimeout or options: the service refuses to start with them.
PROJECT_DB_URL=jdbc:postgresql://localhost:5432/webblock_project
PROJECT_DB_APP_USER=project_app_login
PROJECT_DB_APP_PASSWORD=
# The migrator login is used only where the service migrates (prototype); production holds no migrator password.
PROJECT_DB_MIGRATOR_USER=project_migrator_login
PROJECT_DB_MIGRATOR_PASSWORD=

# Shared catalog database: .claude/docs/runbooks/catalog-database.md.
CATALOG_DB_URL=jdbc:postgresql://localhost:5432/catalog
CATALOG_DB_PLATFORM_USER=catalog_platform_login
CATALOG_DB_PLATFORM_PASSWORD=
# true: the service migrates the catalog at start as the migrator login (prototype). false: something else does.
CATALOG_MIGRATIONS_ENABLED=true
CATALOG_DB_MIGRATOR_USER=catalog_migrator_login
CATALOG_DB_MIGRATOR_PASSWORD=

# RabbitMQ (events leave through the outbox): .claude/docs/runbooks/outbox.md.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=project
RABBITMQ_PASSWORD=

# Token check (production, and prototype with PROJECT_IDENTITY_MODE=jwt): the Keycloak realm issuer.
PROJECT_JWT_ISSUER_URI=http://localhost:8180/realms/webblock

# Payment: the base URL of its internal API. Ignored while the prototype stand-in is on.
PAYMENT_BASE_URL=http://payment.invalid

# The domain sites live under (<subdomain>.<site domain>); today roaa15.xyz on k3s.
PROJECT_SITE_DOMAIN=sites.webblock.test

# Actuator port (health, readiness, metrics).
PROJECT_MANAGEMENT_PORT=8081

# Prototype profile only (production refuses stand-ins).
# dev-tokens: tokens from PROJECT_DEV_TOKENS_FILE, a git-ignored JSON file (mode 0600) of the form
# {"tokens": [{"token", "subject", "userId", "scopes"}]}; every entry needs a userId. jwt: the Keycloak check above.
PROJECT_IDENTITY_MODE=dev-tokens
PROJECT_DEV_TOKENS_FILE=
# stand-in: Payment admits everything unless PROJECT_PAYMENT_STAND_IN_FILE says otherwise. http: the real Payment at
# PAYMENT_BASE_URL (the only mode production allows).
PROJECT_PAYMENT_MODE=stand-in
PROJECT_PAYMENT_STAND_IN_FILE=
