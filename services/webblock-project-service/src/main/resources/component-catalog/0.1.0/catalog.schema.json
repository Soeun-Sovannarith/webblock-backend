{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebBlock component catalog 0.1.0: the Puck data structure. Block props are checked from the version that ships the @webblock block definitions.",
  "type": "object",
  "required": ["root", "content"],
  "additionalProperties": false,
  "properties": {
    "root": {
      "type": "object",
      "required": ["props"],
      "additionalProperties": false,
      "properties": { "props": { "type": "object" } }
    },
    "content": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/component" } },
    "zones": {
      "type": "object",
      "maxProperties": 200,
      "propertyNames": { "pattern": "^[A-Za-z0-9_-]{1,128}:[A-Za-z0-9_-]{1,128}$" },
      "additionalProperties": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/component" } }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["type", "props"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,63}$" },
        "props": {
          "type": "object",
          "required": ["id"],
          "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 128 } }
        }
      }
    }
  }
}
