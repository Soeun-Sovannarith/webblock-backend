{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["root", "content"],
  "additionalProperties": false,
  "properties": {
    "root": { "type": "object", "required": ["props"], "additionalProperties": false, "properties": { "props": { "type": "object" } } },
    "content": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/component" } },
    "zones": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/component" } } }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["type", "props"],
      "additionalProperties": false,
      "properties": { "type": { "enum": ["Heading", "Image"] }, "props": { "type": "object" } },
      "allOf": [
        { "if": { "properties": { "type": { "const": "Heading" } } },
          "then": { "properties": { "props": { "$ref": "#/$defs/headingProps" } } } },
        { "if": { "properties": { "type": { "const": "Image" } } },
          "then": { "properties": { "props": { "$ref": "#/$defs/imageProps" } } } }
      ]
    },
    "headingProps": {
      "type": "object", "required": ["id", "text"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "text": { "type": "string", "maxLength": 200 } }
    },
    "imageProps": {
      "type": "object", "required": ["id", "src"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "minLength": 1 }, "src": { "type": "string" }, "alt": { "type": "string", "maxLength": 300 } }
    }
  }
}
