{
  "name": "clothing-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Juniper & Thread: a demo clothing shop generated for WebBlock. Next.js App Router, reads the shared catalog through Drizzle ORM.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node init && next dev --port 8080",
    "build": "node init && next build",
    "start": "node init && next start --port 8080",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
