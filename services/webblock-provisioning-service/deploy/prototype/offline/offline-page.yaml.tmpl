# The shared offline page (decision 0014 section 3, RouteTargetKind.OFFLINE). A tenant's HTTPRoute
# route-<projectId> points at Service webblock-offline/offline-page port 8080 while hosting is suspended,
# or after a failed first publish (K9). The cross-namespace reference is allowed by a ReferenceGrant
# that tenant-bootstrap creates per tenant in this namespace.
# Every path answers 503 with the offline page and Cache-Control: no-store. Readiness is a TCP check,
# so no path ever answers 200. @OFFLINE_IMAGE@ is replaced by proto-up with the nginx image from the
# local registry, by digest.
apiVersion: v1
kind: ConfigMap
metadata:
  name: offline-page
  namespace: webblock-offline
data:
  default.conf: |
    server {
      listen 8080 default_server;
      server_name _;
      server_tokens off;
      root /usr/share/nginx/offline;
      error_page 503 /offline.html;
      location = /offline.html {
        internal;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "3600" always;
      }
      location / {
        return 503;
      }
    }
  offline.html: |
    <!doctype html>
    <html lang="en">
    <head><meta charset="utf-8"><title>Site offline</title></head>
    <body>
    <h1>Site offline</h1>
    <p>This website is currently offline.</p>
    </body>
    </html>
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: offline-page
  namespace: webblock-offline
  labels:
    app.kubernetes.io/name: offline-page
spec:
  replicas: 1
  revisionHistoryLimit: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: offline-page
  template:
    metadata:
      labels:
        app.kubernetes.io/name: offline-page
    spec:
      automountServiceAccountToken: false
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 101
        runAsGroup: 101
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: nginx
          image: "@OFFLINE_IMAGE@"
          imagePullPolicy: IfNotPresent
          env:
            - name: NGINX_ENTRYPOINT_QUIET_LOGS
              value: "1"
          ports:
            - name: http
              containerPort: 8080
          readinessProbe:
            tcpSocket:
              port: http
            periodSeconds: 5
          livenessProbe:
            tcpSocket:
              port: http
            periodSeconds: 20
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 100m
              memory: 64Mi
          volumeMounts:
            - name: conf
              mountPath: /etc/nginx/conf.d/default.conf
              subPath: default.conf
              readOnly: true
            - name: conf
              mountPath: /usr/share/nginx/offline/offline.html
              subPath: offline.html
              readOnly: true
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: conf
          configMap:
            name: offline-page
        - name: tmp
          emptyDir:
            sizeLimit: 16Mi
---
apiVersion: v1
kind: Service
metadata:
  name: offline-page
  namespace: webblock-offline
spec:
  selector:
    app.kubernetes.io/name: offline-page
  ports:
    - name: http
      port: 8080
      targetPort: http
