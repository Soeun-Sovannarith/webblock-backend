#!/bin/sh
# buildctl against the prototype's BuildKit daemon (container webblock-buildkit on the kind Docker
# network) over mutual TLS. The client certificate and the CA are mounted read-only from
# bin/kind-state/proto/buildkit-tls/client by proto-up. Installed in the Jenkins image as
# /usr/local/bin/webblock-buildctl and used by the Jenkinsfile; no Docker socket is involved.
set -eu
d=/etc/webblock/buildkit
exec /usr/local/bin/buildctl --addr "${WEBBLOCK_BUILDKIT_ADDR:?WEBBLOCK_BUILDKIT_ADDR is not set}" \
  --tlsservername "${WEBBLOCK_BUILDKIT_SERVER_NAME:?WEBBLOCK_BUILDKIT_SERVER_NAME is not set}" \
  --tlscacert "$d/ca.crt" --tlscert "$d/client.crt" --tlskey "$d/client.key" "$@"
