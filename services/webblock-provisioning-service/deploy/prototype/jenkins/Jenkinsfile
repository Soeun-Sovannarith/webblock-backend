// webblock-site-build: the trusted build template of the prototype (decision 0014 section 3).
//
// Provisioning triggers this job with PROJECT_ID, RELEASE_ID, ATTEMPT, REPOSITORY_URL, COMMIT_SHA and
// IMAGE_REPOSITORY and polls it; Jenkins needs no route back. The job builds exactly COMMIT_SHA with
// BuildKit (a separate daemon reached over mutual TLS; no Docker socket), pushes
// IMAGE_REPOSITORY:<RELEASE_ID>-<ATTEMPT>, and archives result.json:
//   success: {"project_id", "release_id", "attempt", "commit_sha", "image_digest"}
//   failure: the same keys (image_digest null, a value null when its parameter was invalid) plus
//            "failure_code": invalid_parameters, clone_failed, commit_not_found, build_failed or
//            push_failed. A timeout or abort reports the code of the step it interrupted.
// The build result is SUCCESS exactly when result.json has no failure_code.
//
// The pipeline is embedded in the job (sandboxed), never read from the built repository, so generated
// code cannot change how it is built. Parameters reach the shell steps only as environment variables
// in single-quoted scripts, never through Groovy string interpolation, and are validated first.
// IMAGE_REPOSITORY must be "$WEBBLOCK_REGISTRY/webblock/sites/$PROJECT_ID", so one project cannot push
// into another project's repository or to another registry.

node {
  String failure = null
  String pending = 'invalid_parameters'
  String headSha = null
  String digest = null
  try {
    deleteDir()
    timeout(time: 30, unit: 'MINUTES') {
      echo('step: validate')
      pending = 'invalid_parameters'
      if (sh(returnStatus: true, label: 'validate parameters', script: '''#!/bin/bash
        set -u
        uuid='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
        ok=1
        # One marker file per identifying parameter that is valid, so result.json can echo it even
        # when another parameter is not.
        [[ ${PROJECT_ID-} =~ $uuid ]] && touch ok-project || { echo "PROJECT_ID is not a lowercase UUID"; ok=0; }
        [[ ${RELEASE_ID-} =~ $uuid ]] && touch ok-release || { echo "RELEASE_ID is not a lowercase UUID"; ok=0; }
        [[ ${ATTEMPT-} =~ ^[1-9][0-9]{0,3}$ ]] && touch ok-attempt || { echo "ATTEMPT is not an integer from 1 to 9999"; ok=0; }
        [[ ${COMMIT_SHA-} =~ ^[0-9a-f]{40}$ ]] && touch ok-commit || { echo "COMMIT_SHA is not a full lowercase SHA-1"; ok=0; }
        [[ ${REPOSITORY_URL-} =~ ^https?://[A-Za-z0-9._~:/@%+-]+$ ]] || { echo "REPOSITORY_URL is not an http(s) URL"; ok=0; }
        [[ -n ${WEBBLOCK_REGISTRY-} ]] || { echo "WEBBLOCK_REGISTRY is not set on the controller"; ok=0; }
        [[ ${IMAGE_REPOSITORY-} == "${WEBBLOCK_REGISTRY-}/webblock/sites/${PROJECT_ID-}" ]] \
          || { echo "IMAGE_REPOSITORY is not <registry>/webblock/sites/<PROJECT_ID>"; ok=0; }
        [ "$ok" = 1 ]
      ''') != 0) {
        failure = pending
      }
      if (failure == null) {
        echo('step: clone')
        pending = 'clone_failed'
        if (sh(returnStatus: true, label: 'clone', script: '''#!/bin/bash
          set -eu
          export GIT_TERMINAL_PROMPT=0
          timeout 300 git -c protocol.file.allow=never clone --quiet --no-checkout -- "$REPOSITORY_URL" src
        ''') != 0) {
          failure = pending
        }
      }
      if (failure == null) {
        echo('step: checkout')
        pending = 'commit_not_found'
        if (sh(returnStatus: true, label: 'checkout the exact commit', script: '''#!/bin/bash
          set -eu
          git -C src -c advice.detachedHead=false checkout --quiet --detach "$COMMIT_SHA^{commit}" 2>/dev/null \
            || { echo "commit $COMMIT_SHA is not in the repository"; exit 1; }
          head="$(git -C src rev-parse HEAD)"
          [ "$head" = "$COMMIT_SHA" ] || { echo "HEAD is $head, not $COMMIT_SHA"; exit 1; }
          printf '%s' "$head" > head-sha
        ''') == 0) {
          headSha = readFile('head-sha').trim()
        } else {
          failure = pending
        }
      }
      if (failure == null) {
        echo('step: build')
        pending = 'build_failed'
        // Build into BuildKit's cache only (no --output exports nothing); the push step below reuses
        // the cache, so a failure here is the build's and a failure there is the push's.
        if (sh(returnStatus: true, label: 'build with BuildKit', script: '''#!/bin/bash
          set -eu
          [ -f src/Dockerfile ] || { echo "the repository has no Dockerfile at its root"; exit 1; }
          timeout 1200 webblock-buildctl build --progress plain \
            --frontend dockerfile.v0 --local context=src --local dockerfile=src \
            --opt platform=linux/amd64
        ''') != 0) {
          failure = pending
        }
      }
      if (failure == null) {
        echo('step: push')
        pending = 'push_failed'
        if (sh(returnStatus: true, label: 'push to the registry', script: '''#!/bin/bash
          set -eu
          timeout 600 webblock-buildctl build --progress plain \
            --frontend dockerfile.v0 --local context=src --local dockerfile=src \
            --opt platform=linux/amd64 \
            --output "type=image,name=$IMAGE_REPOSITORY:$RELEASE_ID-$ATTEMPT,push=true" \
            --metadata-file build-metadata.json
          digest="$(sed -nE 's/.*"containerimage\\.digest": *"(sha256:[0-9a-f]{64})".*/\\1/p' build-metadata.json | head -n 1)"
          [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || { echo "no image digest in the build metadata"; exit 1; }
          printf '%s' "$digest" > image-digest
          echo "pushed $IMAGE_REPOSITORY:$RELEASE_ID-$ATTEMPT as $digest"
        ''') == 0) {
          digest = readFile('image-digest').trim()
        } else {
          failure = pending
        }
      }
    }
  } catch (err) {
    // A timeout, an abort or an unexpected step error: report the step it interrupted.
    if (failure == null) {
      failure = pending
    }
    echo "interrupted during the ${pending} step"
  } finally {
    // Only values the validate step accepted (a marker file each) are echoed; the others are null.
    String q = '"'
    String text = '{' +
      q + 'project_id' + q + ': ' + (fileExists('ok-project') ? q + params.PROJECT_ID + q : 'null') + ', ' +
      q + 'release_id' + q + ': ' + (fileExists('ok-release') ? q + params.RELEASE_ID + q : 'null') + ', ' +
      q + 'attempt' + q + ': ' + (fileExists('ok-attempt') ? params.ATTEMPT : 'null') + ', ' +
      q + 'commit_sha' + q + ': ' + (headSha != null ? q + headSha + q : (fileExists('ok-commit') ? q + params.COMMIT_SHA + q : 'null')) + ', ' +
      q + 'image_digest' + q + ': ' + (failure == null && digest != null ? q + digest + q : 'null')
    if (failure != null) {
      text = text + ', ' + q + 'failure_code' + q + ': ' + q + failure + q
    } else if (digest == null) {
      text = text + ', ' + q + 'failure_code' + q + ': ' + q + pending + q
      failure = pending
    }
    text = text + '}\n'
    writeFile(file: 'result.json', text: text)
    archiveArtifacts(artifacts: 'result.json', allowEmptyArchive: false, fingerprint: false)
    dir('src') {
      deleteDir()
    }
  }
  if (failure != null) {
    error("webblock-site-build failed: ${failure}")
  }
}
