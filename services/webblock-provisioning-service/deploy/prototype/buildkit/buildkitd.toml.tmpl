# BuildKit daemon configuration of the prototype (container webblock-buildkit). proto-ci.sh replaces
# @REGISTRY@ with the registry's in-network address (webblock-proto-registry.test:5000).
#   - The local registry speaks TLS with the project-local CA, mounted at /etc/buildkit/registry-ca.crt.
#   - docker.io pulls try the local registry first, which proto-up fills with the sample site's base
#     image by digest; anything not mirrored falls back to Docker Hub.
#   - Garbage collection keeps the build cache below about 2 GB.
[worker.oci]
  gc = true
  gckeepstorage = "2GB"

[worker.containerd]
  enabled = false

[registry."@REGISTRY@"]
  ca = ["/etc/buildkit/registry-ca.crt"]

[registry."docker.io"]
  mirrors = ["@REGISTRY@"]
