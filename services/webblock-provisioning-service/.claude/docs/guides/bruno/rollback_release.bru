meta {
  name: rollback_release
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/projects/:projectId/releases/:releaseId/rollback
  body: none
  auth: bearer
}

params:path {
  projectId: 
  releaseId: 
}

headers {
  Idempotency-Key: rollback-1
}

auth:bearer {
  token: {{token}}
}

docs {
  Operator recovery of an uncertain route to the live release, or to the offline page when hosting is offline or
  the project has no live release. Contract: src/contracts/openapi.yaml, operation rollback_release.

  Admin only (FR-50): the token must hold the ADMIN role (in the prototype, the prototype-admin
  token). Any other token, the project owner's included, gets 403 ACCESS_DENIED, the same for every project. No
  project access check is made. Accepted only while routingStatus is uncertain; otherwise 422 RELEASE_STATE_INVALID.

  Example answer (202, application/json). Field names are camelCase; data is the result, meta describes the answer:

  ```json
  {
    "success": true,
    "data": {
      "commandId": "0190a1b2-0000-7000-8000-00000000000c",
      "status": "accepted",
      "statusUrl": "/v1/projects/0190a1b2-0000-7000-8000-00000000000a/commands/0190a1b2-0000-7000-8000-00000000000c"
    },
    "meta": {
      "requestId": "0199c3a2-7d10-7c1e-9b3a-5f0e2d4c6a81",
      "timestamp": "2026-10-25T09:30:00.123Z",
      "path": "/v1/projects/0190a1b2-0000-7000-8000-00000000000a/releases/0190a1b2-0000-7000-8000-00000000000b/rollback",
      "status": 202,
      "page": null
    }
  }
  ```
}
