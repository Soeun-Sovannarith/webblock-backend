meta {
  name: list_releases
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/v1/projects/:projectId/releases
  body: none
  auth: bearer
}

params:path {
  projectId: 
}

params:query {
  ~limit: 20
  ~cursor: 
}

auth:bearer {
  token: {{token}}
}

docs {
  List the project's releases, newest first. Contract: src/contracts/openapi.yaml, operation list_releases.

  Query: limit (1 to 50, default 20) and cursor (meta.page.nextCursor of the previous page). page_size and
  page_token are not accepted: 400 VALIDATION_FAILED, field query.

  Example answer (200, application/json). Field names are camelCase; data is the result, meta describes the answer:

  ```json
  {
    "success": true,
    "data": [
      {
        "releaseId": "0190a1b2-0000-7000-8000-00000000000b",
        "projectId": "0190a1b2-0000-7000-8000-00000000000a",
        "gitCommitSha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "containerImageDigest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "status": "rolled_back",
        "failureCode": "site_not_answering",
        "failureRetryable": true,
        "createdAt": "2026-10-08T12:00:00.123456Z",
        "updatedAt": "2026-10-08T12:00:05Z",
        "promotedAt": "2026-10-08T12:00:05Z"
      },
      {
        "releaseId": "0190a1b2-0000-7000-8000-00000000000d",
        "projectId": "0190a1b2-0000-7000-8000-00000000000a",
        "gitCommitSha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "status": "rolled_back",
        "createdAt": "2026-10-08T12:00:00.123456Z",
        "updatedAt": "2026-10-08T12:00:05Z"
      }
    ],
    "meta": {
      "requestId": "0199c3a2-7d10-7c1e-9b3a-5f0e2d4c6a81",
      "timestamp": "2026-10-25T09:30:00.123Z",
      "path": "/v1/projects/0190a1b2-0000-7000-8000-00000000000a/releases",
      "status": 200,
      "page": {
        "limit": 20,
        "nextCursor": "cgAGXVL4ntJAAZChsgAAcACAAAAAAAAADQ"
      }
    }
  }
  ```
}
