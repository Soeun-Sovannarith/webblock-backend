# Provisioning service: every environment setting, with safe example values. Copy, then fill in your own values.
#
# READ THIS FIRST
# - The processes never read a .env file themselves. Load a file into the shell before you start a process:
#     set -a; . ./.env.api; set +a; .venv/bin/python -m provisioning.hosts.api
# - Make ONE FILE PER PROCESS. One shared file cannot work: the api refuses the build worker's keys
#   (BUILD_*, JENKINS_*, PG_BUILD_*, REPOSITORY_MODE), and PG_USER, OPS_LISTEN_ADDR and OTEL_SERVICE_NAME differ
#   per process. Each file = the "shared" block + the block of that process. For example:
#     sed -n '/^# >>> shared/,/^# <<< shared/p;/^# >>> api/,/^# <<< api/p' .env.example > .env.api
#   Blocks: shared, broker, api, worker, build_worker, bootstrap, operator, operator_dlq, devtools.
#   .env and every .env.* file are git-ignored; only .env.example is committed.
# - Every key is REQUIRED unless its comment says "optional". An empty value counts as missing.
# - Keys written as "# KEY=..." are not used with the example's mode; uncomment them only with the mode they name.
# - LOCAL = processes on your machine against the Kind prototype (make proto-up). CLUSTER = pods in DOKS
#   (Helm chart deploy/helm/provisioning: plain keys go in <process>.env, secrets in <process>.secretEnv).
# - For the Kind prototype you do not need this file: `make proto-run` writes complete env files itself
#   (.claude/docs/runbooks/prototype-stack.md). Other runbooks: .claude/docs/runbooks/prototype-in-cluster.md,
#   .claude/docs/runbooks/production-profile.md, .claude/docs/runbooks/identity.md,
#   .claude/docs/runbooks/observability.md.
# - Secrets are "change-me". Never commit a real value.
#
# GITEA (git.roa-dev.digital, namespace webblock-gitea): what Provisioning needs from it
# - No Provisioning process calls Gitea. There is no Gitea URL, user or token key in this service.
# - Jenkins clones the site from Gitea. The build worker only passes REPOSITORY_URL to the Jenkins job; it gets that
#   clone URL from Project (REPOSITORY_MODE=project-grpc, GetRepository.clone_url) or, in the prototype, from
#   PROTOTYPE_REPOSITORIES_FILE. The Gitea read token and the Cloudflare service token jenkins-gitea live in
#   Jenkins' own credentials, never here.
# - Site images go to the Gitea container registry (TRD TR-46, TR-52). BUILD_IMAGE_REGISTRY (build worker) and
#   DEPLOY_IMAGE_REGISTRY (worker) must be the SAME value: the image is <registry>/webblock/sites/<projectId>.
#   Use the public name git.roa-dev.digital, not the in-cluster Service gitea-http.webblock-gitea.svc:3000:
#   the cluster nodes pull the image and cannot resolve .svc names, and Jenkins (outside DOKS) cannot reach them.
#   Gitea reads the first path part, "webblock", as the owner: a Gitea organization "webblock" must exist.

# >>> shared (every process: api, worker, build_worker, bootstrap, operator)
# Run profile: prototype (stand-ins allowed) or production (stand-ins refused). Bootstrap refuses production.
PROVISIONING_PROFILE=prototype
# Optional. Log level: debug, info, warn or error. Default info.
LOG_LEVEL=info
# Provisioning's PostgreSQL. LOCAL: 127.0.0.1 and the port of the prototype database.
# CLUSTER: platform-db-rw.webblock-data.svc, port 5432 (shared CloudNativePG cluster platform-db).
PG_HOST=127.0.0.1
PG_PORT=5432
# Database name.
PG_DATABASE=provisioning
# TLS to PostgreSQL: disable, require, verify-ca or verify-full. LOCAL: disable. CLUSTER: require or stronger.
PG_SSLMODE=disable
# Connection pool size per process (1 to 500).
DB_MAX_CONNS=8
# Database timeouts. Statement timeout at most the transaction timeout; lock timeout at most the statement timeout.
DB_CONNECT_TIMEOUT=5s
DB_TX_TIMEOUT=30s
DB_STATEMENT_TIMEOUT=10s
DB_LOCK_TIMEOUT=5s
# Error reports: "none" turns Sentry off. Otherwise a Sentry DSN (a secret; get it from your Sentry project).
SENTRY_DSN=none
# Only with a real SENTRY_DSN (must be unset with none): environment name and traces sample rate (0 to 1).
# SENTRY_ENVIRONMENT=prototype
# SENTRY_TRACES_SAMPLE_RATE=0
# Optional. Traces by OTLP/HTTP: none (off) or the collector's base URL, for example
# http://tempo.monitoring.svc.cluster.local:4318 in the cluster. Not read by the operator.
OTEL_EXPORTER_OTLP_ENDPOINT=none
# Never set these three: a header can carry a token, so a process with any of them set refuses to start.
# OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST
# OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_RESPONSE
# OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SANITIZE_FIELDS
# <<< shared

# >>> broker (RabbitMQ: copy into the worker and build_worker files)
# Broker URL with user and password (a secret). LOCAL: amqp://provisioning:<password>@127.0.0.1:<port>/.
# CLUSTER: amqps://<user>:<password>@rabbitmq.webblock-data.svc:5671/webblock (AMQPS only, vhost webblock).
RABBITMQ_URL=amqp://provisioning:change-me@127.0.0.1:5672/
# AMQP heartbeat and connect timeout.
RABBITMQ_HEARTBEAT=10s
RABBITMQ_DIAL_TIMEOUT=5s
# Reconnect wait: starts at the base, grows up to the max.
RABBITMQ_RECONNECT_BACKOFF_BASE=200ms
RABBITMQ_RECONNECT_BACKOFF_MAX=5s
# Declare Provisioning's exchanges and queues at start (true or false).
RABBITMQ_DECLARE_TOPOLOGY=true
# Publishes waiting for a broker confirm, at most (1 to 10000).
RABBITMQ_MAX_IN_FLIGHT_PUBLISHES=64
# Largest message in bytes (256 to 1048576).
RABBITMQ_MAX_MESSAGE_BYTES=65536
# Most messages a queue may hold.
RABBITMQ_QUEUE_MAX_LENGTH=10000
# Optional. Deliveries of one message before it goes to the dead-letter queue. Default 5.
RABBITMQ_DELIVERY_LIMIT=5
# How long the broker lets a delivery stay unsettled. Must match the broker's own setting.
RABBITMQ_CONSUMER_TIMEOUT=30m
# Dead-letter queue size and how long a dead letter is kept.
RABBITMQ_DLQ_MAX_LENGTH=10000
RABBITMQ_DLQ_MESSAGE_TTL=168h
# <<< broker

# >>> api (public REST and MCP API)
# Optional. Service name in traces.
OTEL_SERVICE_NAME=provisioning-api
# Login of role provisioning_api, and its password (a secret, from whoever creates the database logins).
PG_USER=prov_api_login
PG_PASS=change-me
# Longest time a command (deploy, promote, rollback) may take in total. Set it equal to the worker's.
COMMAND_DEADLINE=15m
# Public listener and operational listener (/healthz, /readyz); must differ. CLUSTER: 0.0.0.0:8080 and 0.0.0.0:8081.
HTTP_LISTEN_ADDR=127.0.0.1:18080
OPS_LISTEN_ADDR=127.0.0.1:18081
# HTTP limits: request time, keep-alive, shutdown grace, header bytes, body bytes, requests at once.
HTTP_REQUEST_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_GRACE=10s
HTTP_MAX_HEADER_BYTES=16384
HTTP_MAX_REQUEST_BODY_BYTES=65536
HTTP_MAX_IN_FLIGHT=64
# MCP endpoint: body limit, allowed browser origins (none = no browser), allowed Host headers.
MCP_MAX_REQUEST_BODY_BYTES=65536
MCP_ALLOWED_ORIGINS=none
MCP_ALLOWED_HOSTS=127.0.0.1:18080,localhost:18080
# Token check: dev-tokens (prototype only, static tokens from a file) or jwt (Keycloak). Production: jwt only.
IDENTITY_MODE=dev-tokens
# With dev-tokens only: absolute path of the token file (keep it out of git).
AUTH_DEV_TOKENS_FILE=/absolute/path/to/tokens.json
# The scope or role each action needs, action=scope pairs (every action must be listed). With jwt in production
# the scopes are role names of claim roles (USER, ADMIN; see .claude/docs/runbooks/identity.md). The value is one line;
# it is split here with backslash and newline, which the shell joins when you load the file with ". ./file".
# In Helm values write it on one line.
AUTH_ACTION_SCOPES="deploy_release=provisioning:all,promote_release=provisioning:all,\
get_release=provisioning:all,get_command=provisioning:all,\
get_deployment=provisioning:all,get_release_diagnostics=provisioning:all,build_release=provisioning:all,\
list_releases=provisioning:all,list_commands=provisioning:all,rollback_release=ADMIN,\
suspend_website=ADMIN,resume_website=ADMIN,redeploy_release=ADMIN,admin_list_commands=ADMIN"
# With IDENTITY_MODE=jwt only (all required then, refused with dev-tokens). Values from the auth contract.
# web-block-commons does the token check (decision 0024): RS256, the key set from the issuer's discovery
# document, the user_id and roles claims; the former keys for these are refused by name.
# AUTH_ISSUER=https://auth.roa-dev.digital/realms/webblock
# AUTH_AUDIENCE=provisioning
# AUTH_MAX_TOKEN_LIFETIME=1h
# Who owns a project: prototype-allow or prototype-file (prototype only), project-service (REST) or project-grpc.
PROJECT_ACCESS_MODE=prototype-allow
# With prototype-file only: absolute path of the access file.
# PROJECT_ACCESS_FILE=/absolute/path/to/access.json
# With project-service only: the Project service's base URL (CLUSTER: an in-cluster .svc name; ask Project for
# the port).
# PROJECT_SERVICE_URL=http://project.webblock.svc:8080
# With project-grpc only (api), or REPOSITORY_MODE=project-grpc (build_worker): host:port, no scheme.
# PROJECT_GRPC_TARGET=project.webblock.svc:9090
# Entitlement check: prototype-allow, prototype-file or payment-grpc (all prototype only; production must leave
# these unset).
ENTITLEMENT_MODE=prototype-allow
# With prototype-file only: absolute path of the entitlement file.
# ENTITLEMENT_FILE=/absolute/path/to/entitlement.json
# With payment-grpc only: Payment's gRPC host:port, no scheme.
# PAYMENT_GRPC_TARGET=payment.webblock.svc:9090
# Never set this one: it was removed (calls to Project carry no token), and the api refuses it.
# PROJECT_SERVICE_TOKEN_FILE
# <<< api

# >>> worker (deploys, routing, hosting; copy the broker block too)
# Optional. Service name in traces.
OTEL_SERVICE_NAME=provisioning-worker
# Operational listener (/metrics, /healthz). CLUSTER: 0.0.0.0:9090.
OPS_LISTEN_ADDR=127.0.0.1:18082
# Login of role provisioning_worker, and its password (a secret).
PG_USER=prov_worker_login
PG_PASS=change-me
# Login of role provisioning_hosting_intake (Payment events), and its password (a secret). Not the same user.
PG_HOSTING_INTAKE_USER=prov_hosting_login
PG_HOSTING_INTAKE_PASS=change-me
# Longest time a command may take in total; must be above DEPLOY_FINISH_MARGIN and above the 3 go-live tries
# of a promote (615 s with the values here; production-profile.md). Set it equal to the api's.
COMMAND_DEADLINE=15m
# Entitlement (as in the api block) and the hosting entitlement: prototype-payment-events or payment-grpc.
# Production must leave all three unset.
ENTITLEMENT_MODE=prototype-allow
# ENTITLEMENT_FILE=/absolute/path/to/entitlement.json
HOSTING_ENTITLEMENT_MODE=prototype-payment-events
# PAYMENT_GRPC_TARGET=payment.webblock.svc:9090
# Outbox dispatcher: poll pause, batch, publishes at once, confirm wait, claim time, redelivery, backoff.
DISPATCH_POLL_INTERVAL=250ms
DISPATCH_BATCH_SIZE=50
DISPATCH_PUBLISH_CONCURRENCY=8
DISPATCH_PUBLISH_CONFIRM_TIMEOUT=5s
DISPATCH_VISIBILITY_TIMEOUT=10s
DISPATCH_REDELIVERY_INTERVAL=10s
DISPATCH_BACKOFF_BASE=250ms
DISPATCH_BACKOFF_MAX=5s
# Command consumer. WORKER_ID must be unique per replica. Heartbeat at most a third of the lease.
WORKER_ID=prototype-worker-1
WORKER_CONCURRENCY=8
WORKER_LEASE_TTL=15s
WORKER_HEARTBEAT_INTERVAL=3s
# One attempt's time limit: above DEPLOY_READY_TIMEOUT and twice both route deadlines, below RABBITMQ_CONSUMER_TIMEOUT.
WORKER_ATTEMPT_TIMEOUT=10m
# Claim budget of a command: above 3, the go-live tries of a promote.
WORKER_MAX_ATTEMPTS=20
WORKER_RETRY_BACKOFF_BASE=1s
WORKER_RETRY_BACKOFF_MAX=10s
# How long a failed delivery is held when the database fails (max below RABBITMQ_CONSUMER_TIMEOUT).
WORKER_STORE_HOLD_BASE=200ms
WORKER_STORE_HOLD_MAX=5s
WORKER_STORE_FAILURE_LIMIT=5
# Where site images are pulled from: <registry>/webblock/sites/<projectId>@sha256:<digest>. Same as
# BUILD_IMAGE_REGISTRY. Form host[:port][/path], lowercase, no scheme. LOCAL Kind: webblock-proto-registry.test:5000.
# CLUSTER: git.roa-dev.digital (Gitea container registry, see the Gitea notes at the top).
DEPLOY_IMAGE_REGISTRY=git.roa-dev.digital
# Deploy timing: ready wait, poll (at most a third of the ready wait), one cluster call, delete, finish margin,
# abandon. Margin and abandon at least the delete timeout.
DEPLOY_READY_TIMEOUT=150s
DEPLOY_POLL_INTERVAL=1s
DEPLOY_CALL_TIMEOUT=10s
DEPLOY_DELETE_TIMEOUT=30s
DEPLOY_FINISH_MARGIN=30s
DEPLOY_ABANDON_TIMEOUT=30s
# Each site's CPU (millicores) and memory (MiB), and its rollout deadline (below DEPLOY_READY_TIMEOUT).
SITE_CPU_MILLICORES=100
SITE_MEMORY_MIB=256
SITE_PROGRESS_DEADLINE=60s
# Port of the shared "site offline" Service.
SITE_OFFLINE_SERVICE_PORT=8080
# Sites get <subdomain>.<SITE_DOMAIN>. LOCAL Kind: sites.webblock.test. CLUSTER: your sites domain (owner decides).
SITE_DOMAIN=sites.webblock.test
# The Gateway's HTTPS address the promotion probe calls, and the CA file that signs its certificate.
SITE_GATEWAY_HTTPS_URL=https://127.0.0.1:443
SITE_GATEWAY_CA_FILE=/absolute/path/to/gateway-ca.crt
# Probe: path on the site, time per probe, first delete retry wait.
SITE_PROBE_PATH=/readyz
SITE_PROBE_TIMEOUT=5s
SITE_DELETE_RETRY_BASE=250ms
# Optional probe settings: passes needed in a row (default 1), body limit (default 65536), pause (default 0.5s).
SITE_PROBE_SUCCESSES=3
SITE_PROBE_MAX_BODY_BYTES=65536
SITE_PROBE_GAP=500ms
# Secret token of the preview route's probe: 32 to 256 of A-Z a-z 0-9 - _ ("change-me" is too short on purpose).
# Make one with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
PREVIEW_PROBE_TOKEN=change-me
# Route switch and restore deadlines, and the route poll (below both deadlines).
ROUTE_SWITCH_DEADLINE=20s
ROUTE_RESTORE_DEADLINE=60s
ROUTE_POLL_INTERVAL=500ms
# Payment event consumer: consumers at once, retry backoff, retries.
PAYMENT_CONSUMER_CONCURRENCY=2
PAYMENT_RETRY_BACKOFF_BASE=1s
PAYMENT_RETRY_BACKOFF_MAX=10s
PAYMENT_MAX_RETRIES=100
# Kubernetes access: kubeconfig (LOCAL only, a project-local Kind kubeconfig) or in-cluster (CLUSTER, required in
# production).
KUBE_CONNECTION=kubeconfig
# With kubeconfig only: absolute path of the worker's kubeconfig (never ~/.kube/config).
WORKER_KUBECONFIG=/absolute/path/to/bin/kind-state/proto/worker.kubeconfig
# With in-cluster only: the projected token, the cluster CA, and the expected ServiceAccount.
# KUBE_TOKEN_FILE=/var/run/secrets/webblock/kube/token
# KUBE_CA_FILE=/var/run/secrets/webblock/kube/ca.crt
# KUBE_EXPECTED_USERNAME=system:serviceaccount:webblock:provisioning-worker
# Time limit of one Kubernetes API request.
KUBE_REQUEST_TIMEOUT=10s
# Optional. Reconciler pause (default 30s) and projects per round (default 50).
RECONCILE_INTERVAL=30s
RECONCILE_BATCH=50
# Optional. Usage publisher pause (default 5s) and rows per poll (default 50).
USAGE_PUBLISH_INTERVAL=5s
USAGE_BATCH_SIZE=50
# <<< worker

# >>> build_worker (reads source_published, starts and polls Jenkins builds; copy the broker block too)
# Optional. Service name in traces.
OTEL_SERVICE_NAME=provisioning-build-worker
# Operational listener (/metrics, /healthz). CLUSTER: 0.0.0.0:9090.
OPS_LISTEN_ADDR=127.0.0.1:18083
# Login of role provisioning_intake (inbox) and of role provisioning_build (build steps); different users.
PG_INTAKE_USER=prov_intake_login
PG_INTAKE_PASS=change-me
PG_BUILD_USER=prov_build_login
PG_BUILD_PASS=change-me
# Where Jenkins pushes site images: same value as DEPLOY_IMAGE_REGISTRY (see the Gitea notes at the top).
BUILD_IMAGE_REGISTRY=git.roa-dev.digital
# A build's deadline, one call to Jenkins or the repository lookup, and attempts per release.
BUILD_DURATION=20m
BUILD_CALL_TIMEOUT=30s
BUILD_MAX_ATTEMPTS=3
# Jenkins base URL. LOCAL Kind: from bin/kind-state/proto/jenkins.env. CLUSTER: https://jenkins.roa-dev.digital,
# which is behind Cloudflare Access: Provisioning does not send the Access service token headers yet (a code
# change still to build, jenkins-edge README section 3), so calls there are refused until then.
JENKINS_URL=http://127.0.0.1:8080
# Jenkins user and its API token (a secret: Jenkins, user page, Security, API Token).
JENKINS_USER=provisioning
JENKINS_API_TOKEN=change-me
# The site build job path in Jenkins.
JENKINS_JOB=webblock-site-build
# Jenkins timing: one request (at most the operation timeout), one operation, queue polls, their pause, and how
# many recent builds are searched.
JENKINS_REQUEST_TIMEOUT=10s
JENKINS_OPERATION_TIMEOUT=25s
JENKINS_QUEUE_POLLS=20
JENKINS_QUEUE_POLL_INTERVAL=500ms
JENKINS_RECENT_BUILDS=100
# Where the repository clone URL comes from: prototype-file or project-grpc. Production must leave it unset
# (OD-01), and then no build starts.
REPOSITORY_MODE=prototype-file
# With prototype-file only: absolute path of the repositories file.
PROTOTYPE_REPOSITORIES_FILE=/absolute/path/to/repositories.json
# With project-grpc only: Project's gRPC host:port (returns Gitea's clone_url).
# PROJECT_GRPC_TARGET=project.webblock.svc:9090
# Inbox consumer: consumers at once, store hold (max below RABBITMQ_CONSUMER_TIMEOUT), failure limit.
INBOX_CONSUMER_CONCURRENCY=4
INBOX_STORE_HOLD_BASE=200ms
INBOX_STORE_HOLD_MAX=5s
INBOX_STORE_FAILURE_LIMIT=5
# Inbox processor: poll pause, batch, per project, claim time, at once, lookup and transaction limits,
# attempts, deadline, backoff, and pending releases per project.
INBOX_POLL_INTERVAL=1s
INBOX_BATCH_SIZE=10
INBOX_MAX_PER_PROJECT=5
INBOX_VISIBILITY_TIMEOUT=10m
INBOX_CONCURRENCY=5
INBOX_REGISTRY_TIMEOUT=5s
INBOX_TX_TIMEOUT=60s
INBOX_MAX_ATTEMPTS=10
INBOX_DEADLINE=1h
INBOX_BACKOFF_BASE=1s
INBOX_BACKOFF_MAX=30s
INTAKE_MAX_PENDING_PER_PROJECT=20
# Build poller and sweep: pause, limit, at once, sweep transaction limit, grace for a step without a handle.
BUILD_POLL_INTERVAL=2s
BUILD_POLL_LIMIT=50
BUILD_POLL_CONCURRENCY=4
BUILD_SWEEP_INTERVAL=30s
BUILD_SWEEP_LIMIT=50
BUILD_SWEEP_CONCURRENCY=4
BUILD_SWEEP_TX_TIMEOUT=10s
BUILD_DISPATCH_GRACE=1m
# Optional. How long an attempt may stay pending before the poller starts it. Default 30s.
BUILD_PENDING_GRACE=30s
# Build hint listener: queue size, silence before a check, reconnect backoff.
BUILD_HINT_QUEUE_SIZE=256
BUILD_HINT_LIVENESS=30s
BUILD_HINT_RECONNECT_BASE=500ms
BUILD_HINT_RECONNECT_MAX=10s
# <<< build_worker

# >>> bootstrap (creates each site's namespace; prototype profile only)
# Optional. Service name in traces.
OTEL_SERVICE_NAME=provisioning-bootstrap
# Operational listener (/metrics, /healthz). CLUSTER: 0.0.0.0:9090.
OPS_LISTEN_ADDR=127.0.0.1:18084
# Login of the read-only role provisioning_bootstrap, and its password (a secret).
PG_USER=prov_bootstrap_login
PG_PASS=change-me
# Kubernetes access, as in the worker block, with the bootstrap's own identity.
KUBE_CONNECTION=kubeconfig
BOOTSTRAP_KUBECONFIG=/absolute/path/to/bin/kind-state/proto/bootstrap.kubeconfig
# KUBE_TOKEN_FILE=/var/run/secrets/webblock/kube/token
# KUBE_CA_FILE=/var/run/secrets/webblock/kube/ca.crt
# KUBE_EXPECTED_USERNAME=system:serviceaccount:webblock:tenant-bootstrap
KUBE_REQUEST_TIMEOUT=10s
# Each site namespace's quota and the largest container (Kubernetes quantities).
TENANT_QUOTA_CPU=3
TENANT_QUOTA_MEMORY=3Gi
TENANT_QUOTA_PODS=10
TENANT_CONTAINER_MAX_CPU=1
TENANT_CONTAINER_MAX_MEMORY=1Gi
# Loop: pause, projects per round, tenants at once (at most the batch), one tenant's time limit.
BOOTSTRAP_INTERVAL=1s
BOOTSTRAP_BATCH_SIZE=50
BOOTSTRAP_CONCURRENCY=4
BOOTSTRAP_CALL_TIMEOUT=60s
# Optional. Rounds before a ready tenant is checked again. Default 10.
BOOTSTRAP_RECHECK_ROUNDS=10
# The shared catalog database as the access administrator. CLUSTER: catalog-db-rw.webblock-data.svc.
CATALOG_HOST=127.0.0.1
CATALOG_PORT=5432
CATALOG_DATABASE=catalog
CATALOG_SSLMODE=disable
# Access administrator login and password (a secret, from the catalog owner).
CATALOG_ADMIN_USER=change-me
CATALOG_ADMIN_PASS=change-me
CATALOG_CONNECT_TIMEOUT=5s
CATALOG_STATEMENT_TIMEOUT=5s
CATALOG_LOCK_TIMEOUT=2s
# Where the site's pods reach the catalog (written into the site's Secret).
CATALOG_RUNTIME_HOST=webblock-catalog-db
CATALOG_RUNTIME_PORT=5432
# <<< bootstrap

# >>> operator (CLI: re-drive an inbox event; copy the shared block, Sentry and OTEL keys are not read)
# Login of role provisioning_operator, and its password (a secret).
PG_USER=prov_operator_login
PG_PASS=change-me
# <<< operator

# >>> operator_dlq (CLI: "operator dlq ..." commands; needs only PROVISIONING_PROFILE and LOG_LEVEL from shared)
# Broker URL (a secret), connect timeout, and the time limit of each broker call.
RABBITMQ_URL=amqp://provisioning:change-me@127.0.0.1:5672/
RABBITMQ_DIAL_TIMEOUT=5s
DLQ_CALL_TIMEOUT=10s
# <<< operator_dlq

# >>> devtools (LOCAL only: the event simulator, python -m provisioning.devtools.simulate)
# Broker URL the simulator publishes to (a secret).
WEBBLOCK_SIMULATOR_AMQP_URL=amqp://provisioning:change-me@127.0.0.1:5672/
# <<< devtools
