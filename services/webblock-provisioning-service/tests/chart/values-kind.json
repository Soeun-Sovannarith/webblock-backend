  },
  "bootstrap": {
    "env": {"PROVISIONING_PROFILE": "prototype", "KUBE_CONNECTION": "in-cluster", "OPS_LISTEN_ADDR": "0.0.0.0:9090"},
    "secretEnv": ["CATALOG_ADMIN_PASS", "PG_PASS"]
  },
  "networkPolicy": {"database": "172.18.0.7/32", "broker": "172.18.0.8/32", "jenkins": "172.18.0.4/32", "catalog": "172.18.0.6/32"}
