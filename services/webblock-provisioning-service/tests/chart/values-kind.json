  "api": {
    "service": {"type": "LoadBalancer", "annotations": {"lbipam.cilium.io/ips": "172.18.255.250"}},
    "env": {"PROVISIONING_PROFILE": "prototype", "HTTP_LISTEN_ADDR": "0.0.0.0:8080", "OPS_LISTEN_ADDR": "0.0.0.0:8081"},
    "secretEnv": ["PG_PASS"]
  },
  "worker": {
    "env": {"PROVISIONING_PROFILE": "prototype", "KUBE_CONNECTION": "in-cluster", "OPS_LISTEN_ADDR": "0.0.0.0:9090"},
