{
  "image": "webblock-proto-registry.test:5000/webblock/platform/provisioning@sha256:1111111111111111111111111111111111111111111111111111111111111111",
  "standins": true,
  "nodeSelector": {"node-role.kubernetes.io/control-plane": ""},
