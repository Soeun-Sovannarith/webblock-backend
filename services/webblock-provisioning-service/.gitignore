# Local secrets and IDE state
.env
.env.*
!.env.example
dev-tokens.json
.idea/

# Kubeconfigs and private keys never belong in the repository (CLAUDE.md section 0). Exact patterns only:
# tracked code such as config/secret.py and tests/contracts/test_no_default_kubeconfig.py must stay visible.
kubeconfig
*.kubeconfig
*-kubeconfig.yaml
*.pem
*.key
*.p12
*.jks

# Machine-local Claude Code settings (each machine grants its own permissions)
.claude/settings.local.json

# Editor and OS clutter, draw.io backups
*.swp
*~
.DS_Store
Thumbs.db
*.bkp

# Project-local tool binaries and build output
/bin/
/dist/

# Agent workspaces and scan output
.superpowers/
.claude/worktrees/
static_analysis_semgrep_*/

# Output the Go reference's gates leave behind (branch go-reference, decision 0014 section 18), kept
# ignored so that a checkout that switches between the branches never shows it as new files
coverage.out
coverage.*.out
*.test
.vuln-bin.*/
.vulndb-selftest.*/

# Python port (decision 0013 section 10.4): the virtual environment, tool caches, coverage output and
# wheel build output (uv build writes to dist/, already ignored above, unless told otherwise)
.venv/
__pycache__/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage*
htmlcov/
*.whl
# The vendored first-party wheels (webblock-commons, decision 0024) are committed.
!vendor/*.whl
config.bat
node_modules
