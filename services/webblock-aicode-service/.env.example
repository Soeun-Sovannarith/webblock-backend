APP_NAME=WebBlock AI Harness
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://webblock:webblock@localhost:5433/webblock
# Production: DATABASE_URL without credentials (postgres://, postgresql:// or jdbc:postgresql:// also work), plus these.
# Add ?sslmode=require to DATABASE_URL when the server requires TLS.
USER_NAME=
DB_PASSWORD=
# Role Alembic switches to before migrating (production: ai_codegen, the database owner). Empty: the login itself.
DB_MIGRATION_ROLE=
# Generated sites' data, in this database's shared catalog schema, one login role per site (README section 9.7).
# Host, port (0) and database default to DATABASE_URL's; set them when sites reach the database by another address.
SITE_DB_HOST=
SITE_DB_PORT=0
SITE_DB_NAME=
# libpq sslmode the sites use: disable, allow, prefer, require, verify-ca or verify-full.
SITE_DB_SSLMODE=prefer
# Derives each site role's password (HMAC). Empty: sites deploy without a database. Changing it re-keys every role.
SITE_DB_SECRET=
# Role with CREATEROLE (and ADMIN OPTION on webblock_site) the harness switches to when creating site roles.
SITE_ROLE_ADMIN=
# Each new website's storage limit and largest image, in bytes, and the time zone of its opening hours.
SITE_STORAGE_LIMIT_BYTES=104857600
SITE_MAX_IMAGE_BYTES=5242880
SITE_TIMEZONE=Asia/Phnom_Penh
# S3-compatible object storage for product images and logos, passed to every site (path-style URLs).
SITE_STORAGE_ENDPOINT=
SITE_STORAGE_REGION=us-east-1
SITE_STORAGE_BUCKET=
SITE_STORAGE_ACCESS_KEY_ID=
SITE_STORAGE_SECRET_ACCESS_KEY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
REQUEST_TIMEOUT_SECONDS=90

# GLM code updates (OpenAI-compatible chat completions). AI customization requests fail until these are set.
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-4.6
# Stream GLM replies so a proxy such as Cloudflare (524 after ~100 s without data) doesn't cut long code generations.
GLM_STREAM=true
# Let GLM "think" before answering. false (default) makes code generation several times faster.
GLM_THINKING=false
# Only for a self-hosted endpoint behind Cloudflare Access: a service token from Zero Trust > Access > Service Auth.
GLM_CF_ACCESS_CLIENT_ID=
GLM_CF_ACCESS_CLIENT_SECRET=

# Run artifacts (source archive, check report, logs). Must be shared by the API and every worker.
ARTIFACT_DIR=var/artifacts
# Who publishes a successful run: github (this service pushes and deploys) | project (the WebBlock platform: the
# Project Service commits to Gitea, Provisioning builds and deploys; GITHUB_PUSH and DEPLOY are skipped).
PUBLISH_TARGET=github
# Signs the artifact download URLs the Project Service gets from GET /internal/v1/generation-runs/{id} (needed with
# PUBLISH_TARGET=project). ARTIFACT_BASE_URL is how Project reaches this service; URLs live ARTIFACT_URL_TTL_SECONDS (30-600).
ARTIFACT_URL_SECRET=
ARTIFACT_BASE_URL=http://localhost:8000
ARTIFACT_URL_TTL_SECONDS=600

# GitHub: token needs repo contents (and repo creation if GITHUB_OWNER is used for auto-created repos).
GITHUB_TOKEN=
# User or organization that auto-created repos go under (GITHUB_ORGANIZATION_NAME also works).
GITHUB_OWNER=
GITHUB_PRIVATE_REPOS=true
GIT_BRANCH=main

# Deployment: none | webhook (POST to a deploy hook such as Vercel/Netlify/Render).
DEPLOYMENT_PROVIDER=none
DEPLOYMENT_WEBHOOK_URL=
DEPLOYMENT_WEBHOOK_SECRET=
# Public URL of a live site, e.g. https://{subdomain}.example.com (optional).
SITE_URL_TEMPLATE=

# Keycloak realm (public URL; generated sites sign their owners in to the product portal with it).
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/webblock
# Product portal SSO: client with a service account holding realm-management manage-clients + manage-users.
# Empty = sites deploy without portal sign-in. See README "Product portal and single sign-on".
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Admin REST API host when the realm's public host doesn't serve it, e.g. https://kc-admin.example.com (no /realms).
KEYCLOAK_ADMIN_URL=
# Cloudflare Access service token sent to KEYCLOAK_ADMIN_URL only. Unset, it is CF_ACCESS_CLIENT_ID/SECRET (shared
# with GLM). Leave these commented out to use that: an empty value here would override it with nothing.
# KEYCLOAK_CF_ACCESS_CLIENT_ID=
# KEYCLOAK_CF_ACCESS_CLIENT_SECRET=
# Each site's Keycloak client id is <prefix><project_id>.
KEYCLOAK_SITE_CLIENT_PREFIX=webblock-site-

# Build runner: docker (isolated) | local (npm on host, trusted dev only) | skip
BUILD_RUNNER=docker
BUILD_IMAGE=node:22-alpine
BUILD_TIMEOUT_SECONDS=600

# Worker: in-process by default. Set RUN_WORKER=false and run `python -m app.worker` separately to scale.
RUN_WORKER=true
# true = never promote a baseline if build, push or deploy was skipped (use in production).
STRICT_PROMOTION=false

# Codegen flow: "hybrid" (default template + GLM instructions) | "llm" (GLM generates code from Puck JSON on generate & update)
CODEGEN_MODE=llm

KEYCLOAK_ISSUER_URI=https://auth.example.com/realms/webblock
KEYCLOAK_ADMIN_CLIENT_ID=webblock-harness
KEYCLOAK_ADMIN_CLIENT_SECRET=<secret from the Credentials tab>
KEYCLOAK_SITE_CLIENT_PREFIX=webblock-site-
SITE_URL_TEMPLATE=https://{subdomain}.sites.example.com

