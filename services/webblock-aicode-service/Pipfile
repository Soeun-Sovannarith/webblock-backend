[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

# Dependencies live in pyproject.toml; this installs the project (editable) with its dev extras.
[packages]
webblock-fastapi-harness = {path = ".", editable = true, extras = ["dev"]}

[requires]
python_version = "3.13"

[scripts]
dev = "uvicorn app.main:app --reload"
worker = "python -m app.worker"
test = "pytest"
lint = "ruff check ."
