# ==============================================================================
# WebBlock Backend Environment Configuration Template (.env.example)
#
# Copy this file to .env and adjust values for your local or production setup:
#   cp .env.example .env
# ==============================================================================

# --- Keycloak Identity & Access Management ---
KEYCLOAK_SERVER_URL=http://localhost:8180
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/webblock
KEYCLOAK_ADMIN_URL=http://localhost:8180
KEYCLOAK_ADMIN_CLIENT_ID=webblock-auth-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_PASSWORD_CHECK_CLIENT_ID=webblock-password-check
KEYCLOAK_PASSWORD_CHECK_CLIENT_SECRET=
KEYCLOAK_AUDIENCE=webblock-account

# --- PostgreSQL Databases (Local Docker defaults) ---
DB_URL=jdbc:postgresql://localhost:5432/webblock_user
DB_USER=account
DB_PASSWORD=account

PROJECT_DB_URL=jdbc:postgresql://localhost:5432/webblock_project
PROJECT_DB_APP_USER=project_app_login
PROJECT_DB_APP_PASSWORD=project_secret

CATALOG_DB_URL=jdbc:postgresql://localhost:5432/catalog
CATALOG_DB_PLATFORM_USER=catalog_platform_login
CATALOG_DB_PLATFORM_PASSWORD=catalog_secret

# --- Messaging & Cache ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=webblock
RABBITMQ_PASSWORD=webblock

REDIS_HOST=localhost
REDIS_PORT=6379

# --- SMTP / Email (Default: Local Mailpit localhost:1025) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
EMAIL=
GOOGLE_APP_PASSWORD=
MAIL_FROM=WebBlock <no-reply@webblock.local>

# --- Notifications (Knock & Alertmanager) ---
KNOCK_API_KEY=
ALERTMANAGER_WEBHOOK_TOKEN=
